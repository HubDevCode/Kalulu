// Resources of kalulu.exe: icon, manifest and version. build.sh passes
// VER_MAJOR, VER_MINOR, VER_PATCH and VER_STRING to windres.
#include <winver.h>

1 ICON "kalulu.ico"
1 24 "kalulu.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Kalulu"
      VALUE "FileDescription", "Kalulu music player"
      VALUE "FileVersion", VER_STRING
      VALUE "InternalName", "kalulu"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "OriginalFilename", "kalulu.exe"
      VALUE "ProductName", "Kalulu"
      VALUE "ProductVersion", VER_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
